generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: use a pooled connection for the app and a direct one for migrations.
  // See https://neon.tech/docs/guides/prisma
  directUrl = env("DIRECT_URL")
}

// Standard Auth.js (NextAuth) schema, adapted to cuid ids to match the rest
// of this project. See https://authjs.dev/getting-started/adapters/prisma
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Only set for accounts created with the email/password (Credentials)
  // provider. Null for accounts that only ever signed in with Google.
  password      String?
  createdAt     DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  diagnoses      DiagnosisRecord[]
  prescriptions  Prescription[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Each diagnosis belongs to the signed-in user who ran it.
model DiagnosisRecord {
  id             String   @id @default(cuid())
  userId         String
  disease        String
  confidence     Int
  severity       String?
  explanation    String?
  possibleCauses String[] @default([])
  careTips       String[] @default([])
  seekDoctorIf   String?
  disclaimer     String?
  imageUrl       String   @db.Text
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Prescription documents uploaded by users
model Prescription {
  id          String   @id @default(cuid())
  userId      String
  fileName    String
  fileUrl     String   @db.Text
  fileType    String
  fileSize    Int
  doctorName  String?
  clinicName  String?
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, uploadedAt])
}
